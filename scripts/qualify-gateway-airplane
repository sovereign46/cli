checks=$scratch/output/checks.json
clean_python - "$gateway_port" "$checks" <<'PY'
import hashlib
import http.client
import json
import os
import sys

port, output = int(sys.argv[1]), sys.argv[2]
base_model = "s46/devstral-small-2-24b"
backend_model = "devstral-small-2:24b-instruct-2512-q4_K_M"
maximum = 4 << 20


def request(method, path, body=None, timeout=600):
    encoded = None if body is None else json.dumps(body, separators=(",", ":")).encode()
    headers = {} if encoded is None else {"Content-Type": "application/json", "Content-Length": str(len(encoded))}
    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=timeout)
    connection.request(method, path, body=encoded, headers=headers)
    response = connection.getresponse()
    raw = response.read(maximum + 1)
    connection.close()
    if len(raw) > maximum:
        raise SystemExit(f"{path} response exceeds its bound")
    if response.status != 200:
        raise SystemExit(f"{path} returned {response.status}: {raw[:1024]!r}")
    try:
        return json.loads(raw), hashlib.sha256(raw).hexdigest()
    except json.JSONDecodeError as error:
        raise SystemExit(f"{path} returned invalid JSON: {error}")


health, health_digest = request("GET", "/healthz")
if health != {"status": "ok"}:
    raise SystemExit("gateway health response is not exact")
models, models_digest = request("GET", "/v1/models")
if set(models) != {"object", "data"} or models.get("object") != "list" or not isinstance(models.get("data"), list) or len(models["data"]) != 1:
    raise SystemExit("gateway model discovery is not the exact airplane-only list")
model = models["data"][0]
metadata = model.get("metadata", {})
if (model.get("id") != base_model or model.get("object") != "model" or model.get("owned_by") != "sovereign46" or
        metadata.get("id") != base_model or metadata.get("backendModel") != backend_model or
        metadata.get("contextWindow") != 65536 or metadata.get("maxOutputTokens") != 4096 or
        metadata.get("capabilities") != ["chat", "code", "streaming", "tools"]):
    raise SystemExit("gateway model discovery does not bind the exact local model")

completion_nonce = "S46-GATEWAY-COMPLETION-46A7"
completion, completion_digest = request("POST", "/v1/chat/completions", {
    "model": base_model,
    "messages": [
        {"role": "system", "content": "Follow the requested output exactly."},
        {"role": "user", "content": f"Reply with exactly {completion_nonce} and no other text."},
    ],
    "max_tokens": 48,
    "temperature": 0,
    "stream": False,
})
choices = completion.get("choices")
if not isinstance(choices, list) or len(choices) != 1:
    raise SystemExit("completion did not return exactly one choice")
content = choices[0].get("message", {}).get("content")
if content != completion_nonce or choices[0].get("finish_reason") != "stop":
    raise SystemExit("completion did not return the exact requested local-model output")

argument_key = "qualification-key-9f31"
tool_request = {
    "model": base_model,
    "messages": [{
        "role": "user",
        "content": f"Call qualification_lookup with key {argument_key}. After the tool responds, output exactly the marker returned by the tool and no other text.",
    }],
    "tools": [{
        "type": "function",
        "function": {
            "name": "qualification_lookup",
            "description": "Look up a server-generated qualification marker. The tool result contains the marker; after receiving it, reply with exactly that marker.",
            "parameters": {
                "type": "object",
                "properties": {"key": {"type": "string"}},
                "required": ["key"],
                "additionalProperties": False,
            },
        },
    }],
    "tool_choice": {"type": "function", "function": {"name": "qualification_lookup"}},
    "max_tokens": 128,
    "temperature": 0,
    "stream": False,
}
tool_response, tool_digest = request("POST", "/v1/chat/completions", tool_request)
choices = tool_response.get("choices")
if not isinstance(choices, list) or len(choices) != 1 or choices[0].get("finish_reason") != "tool_calls":
    raise SystemExit("model did not finish with one tool call")
assistant = choices[0].get("message")
calls = assistant.get("tool_calls") if isinstance(assistant, dict) else None
if not isinstance(calls, list) or len(calls) != 1:
    raise SystemExit("model did not emit exactly one tool call")
call = calls[0]
function = call.get("function", {})
expected_arguments = json.dumps({"key": argument_key}, separators=(",", ":"), sort_keys=True)
try:
    arguments = json.loads(function.get("arguments", ""))
except json.JSONDecodeError as error:
    raise SystemExit(f"tool arguments are invalid JSON: {error}")
if (call.get("type") != "function" or not isinstance(call.get("id"), str) or not call["id"] or
        function.get("name") != "qualification_lookup" or function.get("arguments") != expected_arguments or
        arguments != {"key": argument_key}):
    raise SystemExit("model tool call name or arguments are not exact")

continuation_nonce = "S46-GATEWAY-CONTINUATION-72C1"
continuation, continuation_digest = request("POST", "/v1/chat/completions", {
    "model": base_model,
    "messages": [
        tool_request["messages"][0],
        {"role": "assistant", "content": assistant.get("content"), "tool_calls": calls},
        {"role": "tool", "tool_call_id": call["id"], "content": json.dumps({"marker": continuation_nonce}, separators=(",", ":"), sort_keys=True)},
    ],
    "tools": tool_request["tools"],
    "tool_choice": "none",
    "max_tokens": 64,
    "temperature": 0,
    "stream": False,
})
choices = continuation.get("choices")
if not isinstance(choices, list) or len(choices) != 1:
    raise SystemExit("tool continuation did not return exactly one choice")
continued = choices[0].get("message", {}).get("content")
if continued != continuation_nonce or choices[0].get("finish_reason") != "stop":
    raise SystemExit("model did not return the exact requested tool-continuation output")

result = {
    "schema": "s46.gateway-qualification-checks.v1",
    "health": {"passed": True, "responseSha256": health_digest},
    "models": {"passed": True, "responseSha256": models_digest},
    "completion": {"passed": True, "responseSha256": completion_digest},
    "toolExecution": {"passed": True, "responseSha256": tool_digest},
    "continuation": {"passed": True, "responseSha256": continuation_digest},
}
raw = (json.dumps(result, sort_keys=True, separators=(",", ":")) + "\n").encode()
descriptor = os.open(output, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0), 0o600)
try:
    view = memoryview(raw)
    while view:
        count = os.write(descriptor, view)
        if count <= 0:
            raise SystemExit("short write creating qualification checks")
        view = view[count:]
    os.fsync(descriptor)
finally:
    os.close(descriptor)
PY

stop_pid "$qualification_pid_gateway"
qualification_pid_gateway=
stop_pid "$qualification_pid_llama"
