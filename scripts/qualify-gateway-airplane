import http.client, json, os, sys, time
port, pid, log = int(sys.argv[1]), int(sys.argv[2]), sys.argv[3]
deadline = time.monotonic() + 600
while time.monotonic() < deadline:
    try:
        os.kill(pid, 0)
    except OSError:
        raise SystemExit("llama-server exited before readiness: " + open(log, errors="replace").read()[-4096:])
    try:
        connection = http.client.HTTPConnection("127.0.0.1", port, timeout=3)
        connection.request("GET", "/v1/models")
        response = connection.getresponse()
        raw = response.read(1 << 20)
        connection.close()
        body = json.loads(raw)
        if response.status == 200 and any(item.get("id") == "devstral-small-2:24b-instruct-2512-q4_K_M" for item in body.get("data", [])):
            raise SystemExit(0)
    except (OSError, ValueError):
        pass
    time.sleep(1)
raise SystemExit("timed out waiting for pinned llama-server")
