def extract_gateway(raw, destination):
    if len(raw) != gateway_expected["archive_size"] or raw[:10] != b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x02\xff":
        raise SystemExit("gateway archive gzip boundary is not canonical")
    inflater = zlib.decompressobj(16 + zlib.MAX_WBITS)
    body = inflater.decompress(raw, (128 << 20) + 1)
    if inflater.unconsumed_tail or len(body) > 128 << 20:
        raise SystemExit("gateway archive expands beyond its bound")
    body += inflater.flush((128 << 20) + 1 - len(body))
    if not inflater.eof or inflater.unused_data or inflater.unconsumed_tail:
        raise SystemExit("gateway archive is not one exact gzip stream")
    with tarfile.open(fileobj=io.BytesIO(body), mode="r:") as archive:
        members = archive.getmembers()
        if len(members) != 1:
            raise SystemExit("gateway archive must contain exactly one member")
        member = members[0]
        if (member.name != "s46-gateway" or not member.isreg() or member.linkname or member.pax_headers or
                member.mode != 0o755 or member.uid != 0 or member.gid != 0 or member.size != gateway_expected["binary_size"]):
            raise SystemExit("gateway archive member identity is invalid")
        source_file = archive.extractfile(member)
        binary = source_file.read(gateway_expected["binary_size"] + 1) if source_file is not None else b""
    if len(binary) != gateway_expected["binary_size"] or hashlib.sha256(binary).hexdigest() != gateway_expected["binary_sha256"]:
        raise SystemExit("gateway binary identity does not match the receipt")
    descriptor = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0), 0o555)
    try:
        write_all(descriptor, binary)
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def extract_llama(archive_path, root):
    os.mkdir(root, 0o700)
    seen = set()
    total = 0
    with tarfile.open(archive_path, mode="r:gz") as archive:
        members = archive.getmembers()
        if not 1 <= len(members) <= 256:
            raise SystemExit("llama.cpp archive member count is invalid")
        for member in members:
            name = member.name.rstrip("/")
            parts = name.split("/")
            if not parts or parts[0] != "llama-b9270" or any(part in ("", ".", "..") for part in parts):
                raise SystemExit("llama.cpp archive contains an unsafe path")
            relative = "/".join(parts[1:])
            if not relative:
                if not member.isdir():
                    raise SystemExit("llama.cpp archive root is not a directory")
                continue
            if relative in seen:
                raise SystemExit("llama.cpp archive contains a duplicate path")
            seen.add(relative)
            destination = os.path.join(root, *parts[1:])
            parent = os.path.dirname(destination)
            os.makedirs(parent, mode=0o700, exist_ok=True)
            if member.isdir():
                os.makedirs(destination, mode=0o700, exist_ok=False)
            elif member.isreg():
                if member.size <= 0 or member.size > 64 << 20:
                    raise SystemExit("llama.cpp archive file is outside its size bound")
                total += member.size
                if total > 128 << 20:
                    raise SystemExit("llama.cpp archive expands beyond its total bound")
                source_file = archive.extractfile(member)
                if source_file is None:
                    raise SystemExit("llama.cpp archive file is unreadable")
                mode = 0o555 if member.mode & 0o111 else 0o444
                descriptor = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0), mode)
                written = 0
                try:
                    while chunk := source_file.read(1024 * 1024):
                        written += len(chunk)
                        if written > member.size:
                            raise SystemExit("llama.cpp archive file grew during extraction")
                        write_all(descriptor, chunk)
                    os.fsync(descriptor)
                finally:
                    os.close(descriptor)
                if written != member.size:
                    raise SystemExit("llama.cpp archive file size is inconsistent")
            elif member.issym():
                target = member.linkname
                if not target or os.path.basename(target) != target or target in (".", ".."):
                    raise SystemExit("llama.cpp archive symlink is unsafe")
                os.symlink(target, destination)
            else:
                raise SystemExit("llama.cpp archive contains a link or special file")
    for base, directories, files in os.walk(root, topdown=False, followlinks=False):
        for name in files:
            path = os.path.join(base, name)
            if not os.path.islink(path):
                current = stat.S_IMODE(os.lstat(path).st_mode)
                os.chmod(path, 0o555 if current & 0o111 else 0o444)
        for name in directories:
            path = os.path.join(base, name)
            if not os.path.islink(path):
                os.chmod(path, 0o555)
    os.chmod(root, 0o555)

    records = []
    count = 0
    for base, directories, files in os.walk(root, topdown=True, followlinks=False):
        for name in directories + files:
            path = os.path.join(base, name)
            relative = os.path.relpath(path, root).replace(os.sep, "/")
            info = os.lstat(path)
            mode = stat.S_IMODE(info.st_mode)
            if stat.S_ISLNK(info.st_mode):
                records.append(f"symlink\t{relative}\t{os.readlink(path)}\n")
            elif stat.S_ISDIR(info.st_mode):
                if mode != 0o555:
                    raise SystemExit("llama.cpp runtime directory is writable")
                records.append(f"dir\t{relative}\t0555\n")
            elif stat.S_ISREG(info.st_mode):
                if mode not in (0o444, 0o555) or info.st_nlink != 1:
                    raise SystemExit("llama.cpp runtime file mode or links are unsafe")
                digest = hashlib.sha256()
                with open(path, "rb", buffering=0) as source_file:
                    while chunk := source_file.read(1024 * 1024):
                        digest.update(chunk)
                records.append(f"file\t{relative}\t{mode:04o}\t{info.st_size}\t{digest.hexdigest()}\n")
            else:
                raise SystemExit("llama.cpp runtime contains a special file")
            count += 1
    inventory = hashlib.sha256("".join(sorted(records)).encode()).hexdigest()
    if inventory != llama_expected["inventory_sha256"]:
        raise SystemExit(f"llama.cpp runtime inventory SHA-256 mismatch: {inventory}")
    server = os.path.join(root, "llama-server")
    info = os.lstat(server)
    digest = hashlib.sha256()
    with open(server, "rb", buffering=0) as source_file:
        while chunk := source_file.read(1024 * 1024):
            digest.update(chunk)
    if info.st_size != llama_expected["server_size"] or digest.hexdigest() != llama_expected["server_sha256"]:
        raise SystemExit("llama-server identity is wrong")
    return count


gateway_destination = os.path.join(input_root, "s46-gateway")
extract_gateway(archive_raw, gateway_destination)
