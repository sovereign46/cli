except (UnicodeDecodeError, json.JSONDecodeError) as error:
    raise SystemExit(f"invalid candidate record JSON: {error}")
if list(record) != ["schema", "id", "state", "sequence", "previousETag", "source", "assets", "annotations"]:
    raise SystemExit("candidate record fields or order are not canonical")
if (record.get("schema") != "s46.release-authority.record.v1" or record.get("id") != release_id or
        record.get("state") != "candidate" or not isinstance(record.get("sequence"), int) or
        isinstance(record.get("sequence"), bool) or record["sequence"] != 2):
    raise SystemExit("candidate is not the exact reviewed sequence-2 record")
source = record.get("source")
if not isinstance(source, dict) or list(source) != ["repository", "tag", "commit", "tagObject", "bundleSha256"]:
    raise SystemExit("candidate source fields are not canonical")
if (source.get("repository") != repository or source.get("tag") != tag or source.get("commit") != commit or
        source.get("tagObject") != "" or not sha256_pattern.fullmatch(source.get("bundleSha256", ""))):
    raise SystemExit("candidate source does not bind the requested repository, tag, and commit")
assets = record.get("assets")
if not isinstance(assets, list) or not 1 <= len(assets) <= 256:
    raise SystemExit("candidate asset ledger is invalid")
asset_by_name = {}
previous_name = ""
for asset in assets:
    if not isinstance(asset, dict) or list(asset) != ["name", "sha256", "size", "mediaType", "role"]:
        raise SystemExit("candidate asset fields are not canonical")
    name = asset.get("name")
    if not isinstance(name, str) or name <= previous_name or not sha256_pattern.fullmatch(asset.get("sha256", "")):
        raise SystemExit("candidate assets are not strictly ordered exact identities")
    if not isinstance(asset.get("size"), int) or isinstance(asset.get("size"), bool) or asset["size"] <= 0:
        raise SystemExit("candidate asset size is invalid")
    if not isinstance(asset.get("mediaType"), str) or not isinstance(asset.get("role"), str):
        raise SystemExit("candidate asset type or role is invalid")
    asset_by_name[name] = asset
    previous_name = name

publisher_annotations = record.get("annotations")
if (not isinstance(publisher_annotations, list) or len(publisher_annotations) != 3 or
        publisher_annotations[0] != {"name": "build-run-id", "value": gateway_expected["build_run_id"]} or
