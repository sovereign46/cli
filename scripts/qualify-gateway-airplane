clean_python - "$scratch" <<'PY'
import os, stat, sys
root = sys.argv[1]
expected_children = {"control", "home", "input", "output", "tmp"}
if set(os.listdir(root)) != expected_children:
    raise SystemExit("qualification scratch root has an unexpected topology")
for child_name in expected_children:
    child = os.lstat(os.path.join(root, child_name))
    expected_mode = 0o555 if child_name == "input" else 0o700
    if (not stat.S_ISDIR(child.st_mode) or child.st_uid != os.geteuid() or
            stat.S_IMODE(child.st_mode) != expected_mode):
        raise SystemExit(f"qualification scratch directory identity is unsafe: {child_name}")
for empty_name in ("home", "output", "tmp"):
    if os.listdir(os.path.join(root, empty_name)):
        raise SystemExit(f"qualification {empty_name} directory was not empty before sandbox entry")
for base, directories, files in os.walk(root, topdown=True, followlinks=False):
    for name in directories + files:
        path = os.path.join(base, name)
        info = os.lstat(path)
        if (info.st_uid != os.geteuid() or
                (not stat.S_ISLNK(info.st_mode) and stat.S_IMODE(info.st_mode) & 0o022)):
            raise SystemExit(f"qualification scratch entry has unsafe ownership or mode: {path}")
        if stat.S_ISREG(info.st_mode) and info.st_nlink != 1:
            raise SystemExit(f"qualification scratch file is multiply linked: {path}")
        if stat.S_ISLNK(info.st_mode):
            target = os.readlink(path)
            if not target or os.path.basename(target) != target or target in (".", ".."):
                raise SystemExit(f"qualification scratch symlink target is unsafe: {path}")
        if not (stat.S_ISREG(info.st_mode) or stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode)):
            raise SystemExit(f"qualification scratch contains a special file: {path}")
root_info = os.lstat(root)
if (not stat.S_ISDIR(root_info.st_mode) or root_info.st_uid != os.geteuid() or
        stat.S_IMODE(root_info.st_mode) != 0o700):
    raise SystemExit("qualification scratch root identity is unsafe")
PY
