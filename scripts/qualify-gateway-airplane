import http.client, json, os, sys, time
port, pid, log = int(sys.argv[1]), int(sys.argv[2]), sys.argv[3]
deadline = time.monotonic() + 60
while time.monotonic() < deadline:
    try:
        os.kill(pid, 0)
    except OSError:
        raise SystemExit("gateway exited before readiness: " + open(log, errors="replace").read()[-4096:])
    try:
        connection = http.client.HTTPConnection("127.0.0.1", port, timeout=3)
        connection.request("GET", "/healthz")
        response = connection.getresponse()
        raw = response.read(1 << 20)
        connection.close()
        if response.status == 200 and json.loads(raw) == {"status": "ok"}:
            raise SystemExit(0)
    except (OSError, ValueError):
        pass
    time.sleep(0.5)
raise SystemExit("timed out waiting for exact gateway binary")
