    "capabilities": ["airplane"],
    "archive": archive,
    "binary": {"name": "s46-gateway", "sha256": archive["binarySha256"], "sizeBytes": archive["binarySizeBytes"]},
    "model": {
        "id": "s46/devstral-small-2-24b",
        "backendModel": "devstral-small-2:24b-instruct-2512-q4_K_M",
        "name": "Devstral-Small-2-24B-Instruct-2512-Q4_K_M.gguf",
        "sha256": "d14ba9edee1bb4c4996a726deb81e49ae81800a3216f0774634238c380aee496",
        "sizeBytes": 14334446752,
    },
    "llamaCpp": {
        "repository": "ggml-org/llama.cpp",
        "version": "b9270",
        "archive": {"name": "llama-b9270-bin-macos-arm64.tar.gz", "sha256": "1a41b5bb3585a79ce90535b2c61671eae60a032ddb2b4992a62eb0d221f9b2bb", "sizeBytes": 8488521},
        "server": {"name": "llama-server", "sha256": "fc05cc348584b01226d1a95bc2282978193d009a02b16d739ff17f9b332b1cda", "sizeBytes": 8023664, "versionOutput": "version: 9270 (7ea23ddf7)"},
        "inventory": {"schema": "s46.llamacpp-runtime-inventory.v1", "sha256": "5188ea71039a80e56a3026fa4c7a823e6b550887a50475fe9c45001ee436c167", "entries": 52},
