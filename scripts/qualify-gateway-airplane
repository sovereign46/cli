    "continuation": {"passed": True, "responseSha256": checks.get("continuation", {}).get("responseSha256")},
}
if checks != {"schema": "s46.gateway-qualification-checks.v1", **execution_checks}:
    raise SystemExit("qualification checks are incomplete")
for item in ("health", "models", "completion", "toolExecution", "continuation"):
    if not re.fullmatch(r"[0-9a-f]{64}", checks[item]["responseSha256"]):
        raise SystemExit("qualification response digest is invalid")
archive = metadata["archive"]
evidence = {
    "schema": "https://s46.dev/schemas/gateway-native-execution/v1",
    "repository": "sovereign46/api",
    "commit": source_commit,
    "version": "0.2.0",
