# Create-only stable handoff to Actions. No authority or GitHub release mutation
# exists in this wrapper.
evidence_sha256=$(sha256_file "$staged_evidence")
clean_python - "$staged_evidence" "$evidence_output" "$evidence_sha256" <<'PY'
import hashlib, os, stat, sys
source, destination, expected = sys.argv[1:]
before = os.lstat(source)
if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
    raise SystemExit("staged evidence is not a singly linked regular file")
raw = open(source, "rb").read()
if hashlib.sha256(raw).hexdigest() != expected:
    raise SystemExit("staged evidence digest changed")
descriptor = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0), 0o600)
try:
    view = memoryview(raw)
    while view:
        count = os.write(descriptor, view)
        if count <= 0:
            raise SystemExit("short write handing off execution evidence")
        view = view[count:]
    os.fsync(descriptor)
finally:
    os.close(descriptor)
if open(destination, "rb").read() != raw:
    raise SystemExit("evidence handoff changed bytes")
PY

printf 'qualified exact gateway candidate: %s\n' "$evidence_output"
