#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
host_home="${HOME:-}"
sandbox="$(mktemp -d "${TMPDIR:-/tmp}/s46-dev-shell.XXXXXX")"
api_repo_default="$(cd "$repo_root/.." && pwd)/s46-api"

cleanup() {
  if [ -d "$sandbox" ]; then
    find -P "$sandbox" -type d -exec chmod u+rwx {} + 2>/dev/null || true
    rm -rf "$sandbox"
  fi
}
trap cleanup EXIT
trap 'exit 143' TERM

seeded_harnesses=()

copy_file_if_exists() {
  local src="$1"
  local dst="$2"
  if [ ! -f "$src" ]; then
    return 1
  fi
  mkdir -p "$(dirname "$dst")"
  if cp -p "$src" "$dst"; then
    return 0
  fi
  echo "[s46] warning: could not copy $src into sandbox" >&2
  return 1
}

copy_dir_if_exists() {
  local src="$1"
  local dst="$2"
  if [ ! -d "$src" ]; then
    return 1
  fi
  mkdir -p "$(dirname "$dst")"
  rm -rf "$dst"
  if cp -pR "$src" "$dst"; then
    return 0
  fi
  echo "[s46] warning: could not copy $src into sandbox" >&2
  return 1
}

seed_harness_configs() {
  if [ -z "$host_home" ] || [ ! -d "$host_home" ]; then
    return 0
  fi

  if copy_dir_if_exists "$host_home/.pi/agent" "$HOME/.pi/agent"; then
    seeded_harnesses+=("pi")
  fi

  if copy_file_if_exists "$host_home/.claude/settings.json" "$HOME/.claude/settings.json"; then
    seeded_harnesses+=("claude-code")
  fi

  if copy_file_if_exists "$host_home/.codex/config.toml" "$HOME/.codex/config.toml"; then
    seeded_harnesses+=("codex")
  fi
}

join_by_comma() {
  local joined=""
  local item
  for item in "$@"; do
    if [ -z "$joined" ]; then
      joined="$item"
    else
      joined="$joined, $item"
    fi
  done
  echo "$joined"
}

url_host_port() {
  local url="$1"
  local rest host port
  rest="${url#*://}"
  rest="${rest%%/*}"
  host="${rest%%:*}"
  if [[ "$rest" == *:* ]]; then
    port="${rest##*:}"
  elif [[ "$url" == https://* ]]; then
    port="443"
  else
    port="80"
  fi
  printf '%s %s\n' "$host" "$port"
}

port_open() {
  local host="$1"
  local port="$2"
  if command -v nc >/dev/null 2>&1; then
    nc -z -w 1 "$host" "$port" >/dev/null 2>&1
    return $?
  fi
  (echo >/dev/tcp/"$host"/"$port") >/dev/null 2>&1
}

check_share_server() {
  local label="$1"
  local url="$2"
  local host port
  read -r host port < <(url_host_port "$url")
  if port_open "$host" "$port"; then
    echo "ready"
  else
    echo "missing"
  fi
}

mkdir -p "$sandbox/home" "$sandbox/home/.ollama" "$sandbox/home/.config" "$sandbox/home/.local/share" "$sandbox/home/.cache" "$sandbox/bin"

cd "$repo_root"
go build -o "$sandbox/bin/s46" ./cmd/s46

export TMP_FOLDER="$sandbox"
export HOME="$TMP_FOLDER/home"
export S46_HOST_HOME="$host_home"
export OLLAMA_MODELS="${OLLAMA_MODELS:-$host_home/.ollama/models}"
export XDG_CONFIG_HOME="$TMP_FOLDER/home/.config"
export XDG_DATA_HOME="$TMP_FOLDER/home/.local/share"
export XDG_CACHE_HOME="$TMP_FOLDER/home/.cache"
if [ -z "${S46_LOG_DIR:-}" ]; then
  if [ -n "$host_home" ]; then
    export S46_LOG_DIR="$host_home/.cache/s46"
  else
    export S46_LOG_DIR="$XDG_CACHE_HOME/s46"
  fi
fi
mkdir -p "$S46_LOG_DIR"
export S46_DEV_SHELL=1
api_base_default="${S46_DEV_BASE_URL:-http://127.0.0.1:8080}"
export S46_API_BASE_URL="${S46_API_BASE_URL:-$api_base_default}"
export S46_DEV_BASE_URL="${S46_DEV_BASE_URL:-$S46_API_BASE_URL}"
export S46_KEYRING_BACKEND=file
share_api_default="http://127.0.0.1:8789"
share_viewer_default="http://127.0.0.1:5173"
export S46_SHARE_API_URL="${S46_SHARE_API_URL:-$share_api_default}"
export S46_SHARE_VIEWER_URL="${S46_SHARE_VIEWER_URL:-$share_viewer_default}"
export S46_SHARE_UPLOAD_TOKEN="${S46_SHARE_UPLOAD_TOKEN:-dev-upload-token}"
unset S46_SHARE_BACKEND
share_gist_status="$(check_share_server "s46-gist" "$S46_SHARE_API_URL")"
share_viewer_status="$(check_share_server "s46-share" "$S46_SHARE_VIEWER_URL")"
seed_harness_configs
if [ -z "${S46_API_REPO:-}" ] && [ -d "$api_repo_default/cmd/s46-api" ]; then
  ln -s "$api_repo_default" "$sandbox/s46-api"
  export S46_API_REPO="$sandbox/s46-api"
elif [ -n "${S46_API_REPO:-}" ]; then
  api_repo_link="$sandbox/s46-api"
  ln -s "$S46_API_REPO" "$api_repo_link"
  export S46_API_REPO="$api_repo_link"
fi
export PATH="$TMP_FOLDER/bin:$PATH"

api_base="$S46_API_BASE_URL"
api_repo_display="${S46_API_REPO:-not configured}"
api_repo_display="${api_repo_display/#$TMP_FOLDER/\$TMP_FOLDER}"
seeded_harnesses_display="none"
if [ "${#seeded_harnesses[@]}" -gt 0 ]; then
  seeded_harnesses_display="$(join_by_comma "${seeded_harnesses[@]}")"
fi
share_status_display="ready"
share_notice="Share dev servers: ready"
if [ "$share_gist_status" != "ready" ] || [ "$share_viewer_status" != "ready" ]; then
  share_status_display="not ready"
  share_notice="Share dev servers: not ready — s46 share will not work until both are running.
  s46-gist  ($S46_SHARE_API_URL): $share_gist_status
    start:  cd ../s46-gist && ./scripts/server
  s46-share ($S46_SHARE_VIEWER_URL): $share_viewer_status
    start:  cd ../s46-share && ./scripts/server"
fi

cat <<EOF
s46 development shell

TMP_FOLDER: $TMP_FOLDER

Temporary HOME: \$TMP_FOLDER/home
Temporary binary: \$TMP_FOLDER/bin/s46
API base: $api_base
Ollama models: $OLLAMA_MODELS
S46 logs: $S46_LOG_DIR
S46 API repo: $api_repo_display
Seeded harness configs: $seeded_harnesses_display
Share API: $S46_SHARE_API_URL
Share viewer: $S46_SHARE_VIEWER_URL
Share dev server status: $share_status_display

$share_notice

Try:
  s46 airplane setup
  s46 login --user <your-email> --device-id dev-laptop --device-name "Dev laptop"
  s46 connect <your-team> --harness=claude-code --dry-run
  s46 connect <your-team> --harness=claude-code
  s46 status

Exit with Ctrl-C, Ctrl-D, or: exit
EOF

shell="${SHELL:-/bin/zsh}"
shell_name="$(basename "$shell")"

run_shell() {
  case "$shell_name" in
    zsh)
      zdotdir="$sandbox/zdot"
      mkdir -p "$zdotdir"
      cat > "$zdotdir/.zshrc" <<'EOF'
TRAPINT() { print; exit 130 }
PROMPT='%F{blue}s46-sandbox%f:%~ %# '
EOF
      export ZDOTDIR="$zdotdir"
      "$shell" -i
      ;;
    bash)
      bashrc="$sandbox/bashrc"
      cat > "$bashrc" <<'EOF'
trap 'printf "\n"; exit 130' INT
PS1='s46-sandbox:\w \$ '
EOF
      "$shell" --rcfile "$bashrc" -i
      ;;
    *)
      "$shell"
      ;;
  esac
}

set +e
run_shell
shell_status=$?
set -e

case "$shell_status" in
  0|130)
    echo "Exited s46 development shell."
    exit 0
    ;;
  *)
    echo "s46 development shell exited with status $shell_status." >&2
    exit "$shell_status"
    ;;
esac
